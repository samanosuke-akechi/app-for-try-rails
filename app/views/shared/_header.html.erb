<header style="padding: 12px 16px; border-bottom: 1px solid #ddd; margin-bottom: 16px;">
  <div style="display: flex; gap: 8px; align-items: center;">
    <% if user_signed_in? %>
      <%= button_to 'ログアウト', destroy_user_session_path, method: :delete, class: 'btn btn-outline-danger btn-sm' %>
      <%= button_to '退会', registration_path(:user), method: :delete,
        data: { confirm: '本当に退会しますか？' },
        class: 'btn btn-outline-secondary btn-sm' %>
    <% else %>
      <%= link_to '新規登録', new_user_registration_path, class: 'btn btn-primary btn-sm' %>
      <%= link_to 'ログイン', new_user_session_path, class: 'btn btn-outline-primary btn-sm' %>
    <% end %>
  </div>
</header>
